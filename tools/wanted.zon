// SPDX-License-Identifier: BSL-1.0

// What the generator writes: the Vulkan this library declares, as data.
//
//     zig build gen -Dvk-xml=<path to vk.xml>
//
// The generator (`tools/genvk.zig`) contains no list of Vulkan's commands, structs
// or enums - only the registry's own conventions (the `Vk` and `VK_` prefixes,
// `sType` and `pNext`, `VkBool32`). Everything about
// *which* commands, structs and enums exist is in this file, and everything about
// *what* they are - member order, sType values, numbers, flag bits - is in the
// registry. To add a command: put its name in the tier it belongs to, and run
// the generator again. What the command needs comes with it.
//
// Vulkan 1.0 is the baseline. A command that belongs to the 1.0 core is a plain
// function pointer in the tables, and a device without it is not a Vulkan
// device. Every other command listed here - later versions, extensions - is an
// optional one, `?*const fn`, and a driver that lacks it leaves it `null`.

.{
    // The registry's API. `vulkansc` is a different API with its own definitions.
    .api = "vulkan",

    // Core versions whose enumerants count: an enum has the values that 1.0
    // gave it plus what these add, so `VkFormat` has the 1.1 formats and
    // `VkStructureType` has the 1.3 tags. The version says nothing about what a
    // *device* supports; see `.baseline`.
    .versions = .{ "VK_VERSION_1_0", "VK_VERSION_1_1", "VK_VERSION_1_2", "VK_VERSION_1_3" },

    // The feature every device is assumed to have. A wanted command that is
    // part of it is required; every other one is optional.
    .baseline = "VK_VERSION_1_0",

    // Extensions whose enumerants (and old names for promoted types) count.
    // Listing one adds its values to the enums it extends and nothing else - it
    // does not add commands or structs; those are asked for by name below or
    // are found because a wanted command needs them. A wanted command from an
    // extension needs that extension here, and the generator says so if it is
    // missing.
    .extensions = .{
        // Presenting.
        "VK_KHR_surface",
        "VK_KHR_swapchain",
        "VK_KHR_win32_surface",
        "VK_KHR_xlib_surface",
        "VK_KHR_xcb_surface",
        "VK_KHR_wayland_surface",
        "VK_KHR_android_surface",
        // Validation messages and object names.
        "VK_EXT_debug_utils",
        "VK_EXT_debug_report",
        // Promoted to core after 1.0, and the names they had before.
        "VK_KHR_get_physical_device_properties2",
        "VK_KHR_get_memory_requirements2",
        "VK_KHR_dynamic_rendering",
        "VK_KHR_synchronization2",
        // `InstanceCreateFlags.enumerate_portability_khr`, which the loader sets
        // for MoltenVK.
        "VK_KHR_portability_enumeration",
        // The bits of `QueueFlags` and the codes of `Result` that types.zig
        // has always named.
        "VK_KHR_display_swapchain",
        "VK_KHR_video_decode_queue",
        "VK_KHR_video_encode_queue",
    },

    // The type `check` and `Error` are generated for: the one every command
    // returns, where negative is a failure.
    .result = "VkResult",

    // How a command is dispatched, which the loader decides by the type of its
    // first argument. Each command listed below is checked against this, so a
    // command in the wrong tier is an error here and not a crash later.
    .dispatch = .{
        .instance = .{ "VkInstance", "VkPhysicalDevice" },
        .device = .{ "VkDevice", "VkQueue", "VkCommandBuffer" },
        // Asked of the instance although the first argument is a device: the
        // loader has no device to ask until this has been called.
        .through_instance = .{"vkGetDeviceProcAddr"},
    },

    // ---- commands, by tier ------------------------------------------------

    // Before there is an instance.
    .global = .{
        "vkCreateInstance",
        "vkEnumerateInstanceExtensionProperties",
        "vkEnumerateInstanceLayerProperties",
        "vkEnumerateInstanceVersion", // 1.1: absent on a 1.0 loader, which is the answer
    },

    // Through the instance: physical devices and surfaces.
    .instance = .{
        "vkDestroyInstance",
        "vkEnumeratePhysicalDevices",
        "vkGetPhysicalDeviceProperties",
        "vkGetPhysicalDeviceFeatures",
        "vkGetPhysicalDeviceQueueFamilyProperties",
        "vkGetPhysicalDeviceMemoryProperties",
        "vkGetPhysicalDeviceFormatProperties",
        "vkGetPhysicalDeviceImageFormatProperties",
        "vkEnumerateDeviceExtensionProperties",
        "vkCreateDevice",
        "vkGetDeviceProcAddr",

        // 1.1 and later, and the extensions they were promoted from.
        "vkGetPhysicalDeviceProperties2",
        "vkGetPhysicalDeviceFeatures2",
        "vkGetPhysicalDeviceMemoryProperties2",
        "vkGetPhysicalDeviceFormatProperties2",
        "vkGetPhysicalDeviceQueueFamilyProperties2",

        // Surfaces.
        "vkDestroySurfaceKHR",
        "vkGetPhysicalDeviceSurfaceSupportKHR",
        "vkGetPhysicalDeviceSurfaceCapabilitiesKHR",
        "vkGetPhysicalDeviceSurfaceFormatsKHR",
        "vkGetPhysicalDeviceSurfacePresentModesKHR",
        // One creator per platform. Each is usable only where its window system
        // is, and is `null` everywhere else.
        "vkCreateWin32SurfaceKHR",
        "vkGetPhysicalDeviceWin32PresentationSupportKHR",
        "vkCreateXlibSurfaceKHR",
        "vkGetPhysicalDeviceXlibPresentationSupportKHR",
        "vkCreateXcbSurfaceKHR",
        "vkGetPhysicalDeviceXcbPresentationSupportKHR",
        "vkCreateWaylandSurfaceKHR",
        "vkGetPhysicalDeviceWaylandPresentationSupportKHR",
        "vkCreateAndroidSurfaceKHR",

        // Validation messages.
        "vkCreateDebugUtilsMessengerEXT",
        "vkDestroyDebugUtilsMessengerEXT",
        "vkSubmitDebugUtilsMessageEXT",
    },

    // Through the device, with no trampoline.
    .device = .{
        // The device itself.
        "vkDestroyDevice",
        "vkGetDeviceQueue",
        "vkDeviceWaitIdle",

        // Memory.
        "vkAllocateMemory",
        "vkFreeMemory",
        "vkMapMemory",
        "vkUnmapMemory",
        "vkFlushMappedMemoryRanges",
        "vkInvalidateMappedMemoryRanges",

        // Buffers, images, samplers.
        "vkCreateBuffer",
        "vkDestroyBuffer",
        "vkCreateBufferView",
        "vkDestroyBufferView",
        "vkCreateImage",
        "vkDestroyImage",
        "vkGetImageSubresourceLayout",
        "vkCreateImageView",
        "vkDestroyImageView",
        "vkCreateSampler",
        "vkDestroySampler",
        "vkGetBufferMemoryRequirements",
        "vkGetImageMemoryRequirements",
        "vkBindBufferMemory",
        "vkBindImageMemory",

        // Render passes and pipelines.
        "vkCreateShaderModule",
        "vkDestroyShaderModule",
        "vkCreatePipelineCache",
        "vkDestroyPipelineCache",
        "vkGetPipelineCacheData",
        "vkMergePipelineCaches",
        "vkCreatePipelineLayout",
        "vkDestroyPipelineLayout",
        "vkCreateRenderPass",
        "vkDestroyRenderPass",
        "vkCreateFramebuffer",
        "vkDestroyFramebuffer",
        "vkCreateGraphicsPipelines",
        "vkCreateComputePipelines",
        "vkDestroyPipeline",

        // Descriptors.
        "vkCreateDescriptorSetLayout",
        "vkDestroyDescriptorSetLayout",
        "vkCreateDescriptorPool",
        "vkDestroyDescriptorPool",
        "vkResetDescriptorPool",
        "vkAllocateDescriptorSets",
        "vkFreeDescriptorSets",
        "vkUpdateDescriptorSets",

        // Command pools and buffers.
        "vkCreateCommandPool",
        "vkDestroyCommandPool",
        "vkResetCommandPool",
        "vkAllocateCommandBuffers",
        "vkFreeCommandBuffers",
        "vkBeginCommandBuffer",
        "vkEndCommandBuffer",
        "vkResetCommandBuffer",

        // Recording: state.
        "vkCmdBindPipeline",
        "vkCmdSetViewport",
        "vkCmdSetScissor",
        "vkCmdSetLineWidth",
        "vkCmdSetDepthBias",
        "vkCmdSetBlendConstants",
        "vkCmdSetDepthBounds",
        "vkCmdSetStencilCompareMask",
        "vkCmdSetStencilWriteMask",
        "vkCmdSetStencilReference",
        "vkCmdBindDescriptorSets",
        "vkCmdBindIndexBuffer",
        "vkCmdBindVertexBuffers",
        "vkCmdPushConstants",

        // Recording: drawing and dispatching.
        "vkCmdDraw",
        "vkCmdDrawIndexed",
        "vkCmdDrawIndirect",
        "vkCmdDrawIndexedIndirect",
        "vkCmdDispatch",
        "vkCmdDispatchIndirect",

        // Recording: render passes.
        "vkCmdBeginRenderPass",
        "vkCmdNextSubpass",
        "vkCmdEndRenderPass",
        "vkCmdExecuteCommands",
        "vkCmdClearAttachments",

        // Recording: copies and clears.
        "vkCmdCopyBuffer",
        "vkCmdCopyImage",
        "vkCmdBlitImage",
        "vkCmdCopyBufferToImage",
        "vkCmdCopyImageToBuffer",
        "vkCmdUpdateBuffer",
        "vkCmdFillBuffer",
        "vkCmdClearColorImage",
        "vkCmdClearDepthStencilImage",
        "vkCmdResolveImage",

        // Recording: synchronisation and queries.
        "vkCmdPipelineBarrier",
        "vkCmdSetEvent",
        "vkCmdResetEvent",
        "vkCmdWaitEvents",
        "vkCmdBeginQuery",
        "vkCmdEndQuery",
        "vkCmdResetQueryPool",
        "vkCmdWriteTimestamp",
        "vkCmdCopyQueryPoolResults",

        // Queries.
        "vkCreateQueryPool",
        "vkDestroyQueryPool",
        "vkGetQueryPoolResults",

        // Synchronisation and submission.
        "vkCreateFence",
        "vkDestroyFence",
        "vkResetFences",
        "vkGetFenceStatus",
        "vkWaitForFences",
        "vkCreateSemaphore",
        "vkDestroySemaphore",
        "vkCreateEvent",
        "vkDestroyEvent",
        "vkGetEventStatus",
        "vkSetEvent",
        "vkResetEvent",
        "vkQueueSubmit",
        "vkQueueWaitIdle",

        // Presenting.
        "vkCreateSwapchainKHR",
        "vkDestroySwapchainKHR",
        "vkGetSwapchainImagesKHR",
        "vkAcquireNextImageKHR",
        "vkQueuePresentKHR",

        // Names and labels, for the validation layer and for capture tools.
        "vkSetDebugUtilsObjectNameEXT",
        "vkSetDebugUtilsObjectTagEXT",
        "vkQueueBeginDebugUtilsLabelEXT",
        "vkQueueEndDebugUtilsLabelEXT",
        "vkQueueInsertDebugUtilsLabelEXT",
        "vkCmdBeginDebugUtilsLabelEXT",
        "vkCmdEndDebugUtilsLabelEXT",
        "vkCmdInsertDebugUtilsLabelEXT",

        // 1.1 and later - optional, and what a backend uses when it is there.
        "vkGetBufferMemoryRequirements2",
        "vkGetImageMemoryRequirements2",
        "vkCmdBeginRendering", // 1.3, or VK_KHR_dynamic_rendering
        "vkCmdEndRendering",
        "vkCmdPipelineBarrier2", // 1.3, or VK_KHR_synchronization2
        "vkQueueSubmit2",
    },

    // ---- what the commands do not reach -----------------------------------

    // Structs no wanted command mentions: the ones that hang off a `next`
    // chain. Their members come with them.
    .structs = .{
        "VkPhysicalDeviceDynamicRenderingFeatures",
        "VkPhysicalDeviceSynchronization2Features",
        "VkPipelineRenderingCreateInfo",
        "VkPhysicalDeviceDriverProperties",
    },

    // Enums nothing wanted names.
    .enums = .{
        "VkPipelineCacheHeaderVersion",
    },

    // API constants beyond the array sizes that structs need.
    .constants = .{
        "VK_TRUE",
        "VK_FALSE",
        "VK_WHOLE_SIZE",
        "VK_QUEUE_FAMILY_IGNORED",
        "VK_SUBPASS_EXTERNAL",
        "VK_ATTACHMENT_UNUSED",
        "VK_REMAINING_MIP_LEVELS",
        "VK_REMAINING_ARRAY_LAYERS",
        "VK_LOD_CLAMP_NONE",
    },

    // ---- spelling ---------------------------------------------------------

    // Structs whose every member starts at zero or null although the registry
    // does not say any of them may be. (A struct that is nothing but `VkBool32`
    // switches gets this without being listed.)
    .zero_defaults = .{"VkApplicationInfo"},

    // Names that would be a Zig keyword, or that the library already spells
    // differently.
    .rename = .{
        .{ .from = "VK_TRUE", .to = "vk_true" },
        .{ .from = "VK_FALSE", .to = "vk_false" },
    },

    // Types the registry uses and a platform's header defines. `zig` is what a
    // declaration that mentions it becomes - an opaque pointer, so that the file
    // compiles on every platform - and `c` is a stand-in for the layout oracle,
    // which cannot include a window system's real header on a machine that
    // does not have it.
    .platform_types = .{
        .{ .name = "HINSTANCE", .zig = "*anyopaque", .c = "typedef void* HINSTANCE;" },
        .{ .name = "HWND", .zig = "*anyopaque", .c = "typedef void* HWND;" },
        .{ .name = "HMONITOR", .zig = "*anyopaque", .c = "typedef void* HMONITOR;" },
        .{ .name = "HANDLE", .zig = "*anyopaque", .c = "typedef void* HANDLE;" },
        .{ .name = "DWORD", .zig = "u32", .c = "typedef unsigned int DWORD;" },
        .{ .name = "LPCWSTR", .zig = "[*:0]const u16", .c = "typedef const unsigned short* LPCWSTR;" },
        .{ .name = "SECURITY_ATTRIBUTES", .zig = "anyopaque", .c = "typedef struct SECURITY_ATTRIBUTES SECURITY_ATTRIBUTES;" },
        .{ .name = "Display", .zig = "anyopaque", .c = "typedef struct _XDisplay Display;" },
        .{ .name = "VisualID", .zig = "c_ulong", .c = "typedef unsigned long VisualID;" },
        .{ .name = "Window", .zig = "c_ulong", .c = "typedef unsigned long Window;" },
        .{ .name = "xcb_connection_t", .zig = "anyopaque", .c = "typedef struct xcb_connection_t xcb_connection_t;" },
        .{ .name = "xcb_visualid_t", .zig = "u32", .c = "typedef uint32_t xcb_visualid_t;" },
        .{ .name = "xcb_window_t", .zig = "u32", .c = "typedef uint32_t xcb_window_t;" },
        .{ .name = "wl_display", .zig = "anyopaque", .c = "struct wl_display;" },
        .{ .name = "wl_surface", .zig = "anyopaque", .c = "struct wl_surface;" },
        .{ .name = "ANativeWindow", .zig = "anyopaque", .c = "" },
    },

    // Hand-written declarations that belong inside a generated type - the
    // methods `types.zig` has always had. Each is `methods.<Type>.<name>` in
    // `src/methods.zig`, attached to the generated type so that `props.name()`
    // works.
    .methods = .{
        .{ .type = "VkPhysicalDeviceType", .decls = .{"label"} },
        .{ .type = "VkExtensionProperties", .decls = .{"name"} },
        .{ .type = "VkLayerProperties", .decls = .{ "name", "describe" } },
        .{ .type = "VkPhysicalDeviceProperties", .decls = .{"name"} },
        .{ .type = "VkPhysicalDeviceMemoryProperties", .decls = .{ "types", "heaps", "deviceLocalBytes" } },
        .{ .type = "VkInstanceCreateInfo", .decls = .{ "setLayers", "setExtensions" } },
        .{ .type = "VkDeviceCreateInfo", .decls = .{ "setQueues", "setExtensions" } },
        .{ .type = "VkDeviceQueueCreateInfo", .decls = .{"queues"} },
    },
}
